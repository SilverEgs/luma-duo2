-#if IS_ENABLED(CONFIG_NF_TABLES)
+/*
+ * Luma Duo 2: nf_tables is built out of tree against a kernel configured
+ * without it, so struct net has no "nft" member (net_namespace.h only adds
+ * it when CONFIG_NF_TABLES is set) and the per-namespace state lives in
+ * net_generic storage instead, as in later kernels.
+ */
+#include <net/netns/generic.h>
+#include <net/netns/nftables.h>
+
+extern unsigned int nf_tables_net_id;
+
+static inline struct netns_nftables *nft_pernet(const struct net *net)
+{
+	return net_generic(net, nf_tables_net_id);
+}
 
