From: luma-duo2
Subject: translate: fall back to the firmware search path without remoteproc

Qualcomm's downstream subsystem/PIL kernels (msm-5.4) register an empty
remoteproc class and load MPSS firmware by bare name from the firmware
search path. With no remoteproc device to read a firmware directory from,
every /readonly request (modem_pr/mcfg, modem_pr/so ...) is rejected. Fall
back to <firmware_class.path>/<file>, then /lib/firmware/<file>.

--- a/translate.c
+++ b/translate.c
@@ -80,6 +80,7 @@
 	ssize_t n;
 	int fd = -1;
 
+	fw_sysfs_path[0] = '\0';
 	read_fw_path_from_sysfs(fw_sysfs_path, sizeof(fw_sysfs_path));
 
 	class_fd = open("/sys/class/remoteproc", O_RDONLY | O_DIRECTORY);
@@ -164,6 +165,24 @@
 	free(firmware_value_copy);
 	closedir(class_dir);
 
+	/*
+	 * Qualcomm's downstream subsystem/PIL kernels (msm-5.4) register an
+	 * empty remoteproc class and load firmware by bare name from the
+	 * firmware search path, so fall back to serving the file from there.
+	 */
+	if (fd < 0 && strlen(fw_sysfs_path) > 0 &&
+	    strlen(fw_sysfs_path) + 1 + strlen(file) + 1 < sizeof(path)) {
+		strcpy(path, fw_sysfs_path);
+		strcat(path, "/");
+		strcat(path, file);
+		fd = open_maybe_compressed(path);
+	}
+	if (fd < 0 && strlen(FIRMWARE_BASE) + strlen(file) + 1 < sizeof(path)) {
+		strcpy(path, FIRMWARE_BASE);
+		strcat(path, file);
+		fd = open_maybe_compressed(path);
+	}
+
 	return fd;
 }
 
