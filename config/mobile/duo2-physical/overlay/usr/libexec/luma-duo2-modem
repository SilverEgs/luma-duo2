#!/bin/sh
# Luma Duo 2: the SoC's cellular modem (MPSS) on Microsoft's 5.4 kernel
# (docs/modem.md).
#
# Usage: luma-duo2-modem setup|ready|net IFACE
#   setup  before the modem boots (luma-duo2-modem-setup.service)
#   ready  once it has booted (ExecStartPost of luma-duo2-modem.service)
#   net    for an rmnet_ipa netdev that appears later, after a modem restart
#          of its own (luma-duo2-modem-net@.service, from the udev rule)
#
# setup:
#  1. The MPSS firmware stays on the phone's own read-only modem partition,
#     mounted at /run/luma-duo2/firmware/modem (shared with Wi-Fi,
#     luma-duo2-radio-firmware.service); /usr/lib/firmware/modem.* link there.
#  2. A modem crash restarts the modem alone instead of the whole phone
#     (the subsystem default is SYSTEM, a full restart).
#  3. The IPA, the modem's data path: until the device tree carries the fixed
#     qcom,scaling-exceptions string list its probe fails; duo2_ipa_dtfix
#     repairs the property and the driver is bound again. Then its firmware
#     (ipa_fws) is loaded, as Android's ipa_fws.rc does with "write /dev/ipa 1".
#
# ready, and net for each new rmnet_ipa netdev, once the QMI services are up:
#  4. rmnet_ipa connects its WAN pipes to the IPA only when asked, as
#     Android's netmgrd does; luma-duo2-ipa-wan asks, once per instance of
#     the netdev (rmnet_ipa re-creates it at every modem start). The
#     kernel's rmnet driver (a module here) carries ModemManager's data
#     links on top of it.
#  5. ModemManager only takes a Qualcomm SoC modem together with a net port
#     whose parent driver is "ipa", and opens the modem's data port (QMI
#     DPM) with the IPA endpoint numbers it finds under that parent;
#     Microsoft's rmnet_ipa0 has no parent and the vendor IPA no such
#     attributes. duo2_ipa_netparent provides both, after the QMI services
#     are up so that ModemManager probes the two ports together.
#
# ready:
#  6. The GNSS engine emits only Qualcomm's proprietary NMEA until the
#     standard sentences are selected; geoclue needs GGA and RMC. The
#     setting would live in the modem's EFS, which rmtfs serves read-only,
#     so it is applied at every modem start.
set -u

FW=/run/luma-duo2/firmware/modem
IPA=1e00000.qcom,ipa
IPADRV=/sys/bus/platform/drivers/ipa
NETPARENT=/sys/module/duo2_ipa_netparent/parameters/reparent
IPAWAN=/usr/libexec/luma-duo2-ipa-wan
STATE=/run/luma-duo2

log() { echo "luma-duo2-modem: $*" >&2; }

subsys() {   # name -> sysfs directory
    for s in /sys/bus/msm_subsys/devices/*; do
        [ "$(cat "$s/name" 2>/dev/null)" = "$1" ] && { echo "$s"; return 0; }
    done
    return 1
}

qrtr_has() {   # service id -> true once the modem (node 0) offers it
    qrtr-lookup "$1" 2>/dev/null | awk -v s="$1" '$1 == s && $4 == 0 { f = 1 } END { exit !f }'
}

setup() {
    slot=$(sed -n 's/.*androidboot\.slot_suffix=\(_[ab]\).*/\1/p' /proc/cmdline)
    if ! mountpoint -q "$FW"; then
        mkdir -p "$FW"
        mount -t vfat -o ro,nosuid,nodev,noexec,shortname=lower,umask=0222 \
            "/dev/disk/by-partlabel/modem$slot" "$FW" ||
            { log "cannot mount modem$slot"; exit 1; }
    fi
    [ -f "$FW/image/modem.mdt" ] || { log "no modem.mdt on modem$slot"; exit 1; }

    s=$(subsys modem) && echo RELATED >"$s/restart_level"

    if [ ! -e "$IPADRV/$IPA" ]; then
        modprobe duo2_ipa_dtfix && echo "$IPA" >"$IPADRV/bind" ||
            log "IPA did not probe: no modem data (docs/modem.md)"
    fi
    if [ -e /dev/ipa ]; then
        echo 1 >/dev/ipa
        s=$(subsys ipa_fws)
        for i in $(seq 30); do
            [ "$(cat "$s/state" 2>/dev/null)" = ONLINE ] && break
            sleep 1
        done
        [ "$(cat "$s/state" 2>/dev/null)" = ONLINE ] || log "IPA firmware not loaded"
    fi
    exit 0
}

# Wait up to 90 s for DMS (2), WDA (26) and DPM (47) on the modem's node,
# plus any given; only a modem without DMS counts as not up.
qmi_wait() {
    for i in $(seq 90); do
        ok=1
        for svc in 2 26 47 "$@"; do
            qrtr_has "$svc" || { ok=; break; }
        done
        [ -n "$ok" ] && return 0
        sleep 1
    done
    log "QMI services 2 26 47 $* not all up after 90 s"
    qrtr_has 2
}

modules() {
    modprobe rmnet ||
        log "no rmnet module: ModemManager cannot create data links"
    modprobe duo2_ipa_netparent ||
        log "no duo2_ipa_netparent: ModemManager will not take the modem"
}

# Steps 4 and 5 for one rmnet_ipa netdev, serialised with any other caller.
net_port() {
    mkdir -p "$STATE"
    (
        flock 9
        idx=$(cat "/sys/class/net/$1/ifindex" 2>/dev/null) ||
            { log "$1 is gone"; exit 0; }
        if [ "$(cat "$STATE/ipa-wan.$1" 2>/dev/null)" != "$idx" ]; then
            if "$IPAWAN" -i "$1" setup; then
                echo "$idx" >"$STATE/ipa-wan.$1"
            else
                log "IPA WAN pipes of $1 not set up: no mobile data"
            fi
        fi
        if [ -e "$NETPARENT" ]; then
            echo "$1" >"$NETPARENT" || log "could not parent $1 to the IPA"
        fi
    ) 9>"$STATE/modem-net.lock"
}

ready() {
    qmi_wait 16 || { log "modem QMI services did not appear"; exit 1; }

    modules
    for n in /sys/class/net/rmnet_ipa*; do
        [ -e "$n" ] && net_port "${n##*/}"
    done

    for i in 1 2 3 4 5; do
        qmicli -d qrtr://0 --loc-set-nmea-types='gga|rmc|gsv|gsa|vtg' >/dev/null 2>&1 &&
            exit 0
        sleep 2
    done
    log "could not select the standard NMEA sentences"
    exit 0
}

net() {
    case "$1" in rmnet_ipa*) ;; *) log "not an rmnet_ipa netdev: $1"; exit 2 ;; esac
    qmi_wait || { log "modem QMI services did not appear"; exit 1; }
    modules
    net_port "$1"
}

case "${1:-}" in
setup) setup ;;
ready) ready ;;
net) [ $# -eq 2 ] || { echo "usage: luma-duo2-modem net IFACE" >&2; exit 2; }; net "$2" ;;
*) echo "usage: luma-duo2-modem setup|ready|net IFACE" >&2; exit 2 ;;
esac
