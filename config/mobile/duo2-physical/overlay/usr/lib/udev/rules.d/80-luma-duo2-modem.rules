# Luma Duo 2: the cellular modem (docs/modem.md).

# Microsoft's kernel shares the modem's EFS buffer as the UIO device
# "rmtfs" (msm_sharedmem); rmtfs looks for it as /dev/qcom_rmtfs_uio1.
SUBSYSTEM=="uio", ATTR{name}=="rmtfs", SYMLINK+="qcom_rmtfs_uio1", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="rmtfs.service"

# rmnet_ipa re-creates its netdev at every modem start, without data pipes
# and without a parent; luma-duo2-modem sets up both again once the modem's
# QMI services are up (at boot and after a restart of luma-duo2-modem.service
# it has done so already, and the unit finds nothing left to do).
ACTION=="add", SUBSYSTEM=="net", KERNEL=="rmnet_ipa[0-9]*", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}+="luma-duo2-modem-net@%k.service"
