[Unit]
Description=Luma Duo 2: modem firmware partition, restart policy and IPA
Documentation=https://github.com/none24smu/luma-duo2/blob/main/docs/modem.md
DefaultDependencies=no
After=local-fs.target systemd-udevd.service systemd-modules-load.service
After=luma-duo2-radio-firmware.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/luma-duo2-modem setup
