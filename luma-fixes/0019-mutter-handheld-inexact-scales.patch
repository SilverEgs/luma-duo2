diff --git a/patches/mutter/0030-monitor-Offer-inexact-scales-on-a-handheld-panel.patch b/patches/mutter/0030-monitor-Offer-inexact-scales-on-a-handheld-panel.patch
new file mode 100644
index 00000000..aa3c454f
--- /dev/null
+++ b/patches/mutter/0030-monitor-Offer-inexact-scales-on-a-handheld-panel.patch
@@ -0,0 +1,115 @@
+From: none24smu <210309088+none24smu@users.noreply.github.com>
+Subject: [PATCH] monitor: Offer inexact scales on a handheld panel
+
+A handheld panel may run at a scale that does not divide it exactly: the
+Surface Duo 2's 1344x1892 panels at 2.5, Android's density for them. On a
+handheld (LUMA_DEVICE_CLASS=handheld) such scales are offered with the
+logical size rounded to whole pixels (538x757), and a logical monitor
+configuration of that rounded size verifies. They are never chosen
+automatically; a monitors.xml picks one.
+
+---
+diff --git a/src/backends/meta-monitor-config-manager.c b/src/backends/meta-monitor-config-manager.c
+--- a/src/backends/meta-monitor-config-manager.c
++++ b/src/backends/meta-monitor-config-manager.c
+@@ -1852,6 +1852,17 @@ meta_verify_logical_monitor_config (MetaLogicalMonitorConfig    *logical_monitor
+         float scaled_width = mode_width / scale;
+         float scaled_height = mode_height / scale;
+ 
++        /* A handheld panel at an inexact scale: its layout is the rounded
++         * logical size (meta_monitor_allows_inexact_scales()). */
++        if (meta_monitor_allows_inexact_scales () &&
++            layout_width == (int) roundf (scaled_width) &&
++            layout_height == (int) roundf (scaled_height))
++          {
++            expected_mode_width = mode_width;
++            expected_mode_height = mode_height;
++            break;
++          }
++
+         if (floorf (scaled_width) != scaled_width ||
+             floorf (scaled_height) != scaled_height)
+           {
+diff --git a/src/backends/meta-monitor-private.h b/src/backends/meta-monitor-private.h
+--- a/src/backends/meta-monitor-private.h
++++ b/src/backends/meta-monitor-private.h
+@@ -231,6 +231,12 @@ float * meta_monitor_calculate_supported_scales (MetaMonitor                 *mo
+                                                  MetaMonitorScalesConstraint  constraints,
+                                                  int                         *n_supported_scales);
+ 
++gboolean meta_monitor_allows_inexact_scales (void);
++
++gboolean meta_monitor_scale_is_exact (int   width,
++                                      int   height,
++                                      float scale);
++
+ META_EXPORT_TEST
+ const char * meta_monitor_mode_get_id (MetaMonitorMode *monitor_mode);
+ 
+diff --git a/src/backends/meta-monitor.c b/src/backends/meta-monitor.c
+--- a/src/backends/meta-monitor.c
++++ b/src/backends/meta-monitor.c
+@@ -2394,11 +2394,14 @@ calculate_scale (MetaMonitor                *monitor,
+                                                     constraints,
+                                                     &n_scales);
+   best_scale = scales[0];
+-  for (int i = 0; i < n_scales; i++)
++  for (int i = 0, n_exact = 0; i < n_scales; i++)
+     {
+       float scale_error = fabsf (scales[i] - perfect_scale);
+ 
+-      if (i == 0 || scale_error < best_scale_error)
++      if (!meta_monitor_scale_is_exact (width_px, height_px, scales[i]))
++        continue;
++
++      if (n_exact++ == 0 || scale_error < best_scale_error)
+         {
+           best_scale = scales[i];
+           best_scale_error = scale_error;
+@@ -2503,6 +2506,30 @@ highest_common_factor (unsigned int x,
+   return MAX (a, b);
+ }
+ 
++/*
++ * Luma: a handheld panel may run at a scale that does not divide it exactly
++ * (the Surface Duo 2's 1344x1892 at 2.5, Android's density for it): its
++ * logical size is the rounded one, and at most a pixel of the framebuffer
++ * edge goes unused. Such scales are offered but never chosen automatically;
++ * a monitors.xml picks one.
++ */
++gboolean
++meta_monitor_allows_inexact_scales (void)
++{
++  return g_strcmp0 (g_getenv ("LUMA_DEVICE_CLASS"), "handheld") == 0;
++}
++
++gboolean
++meta_monitor_scale_is_exact (int   width,
++                             int   height,
++                             float scale)
++{
++  float w = width / scale, h = height / scale;
++
++  return G_APPROX_VALUE (w, roundf (w), 0.001f) &&
++         G_APPROX_VALUE (h, roundf (h), 0.001f);
++}
++
+ typedef void (* ForEachScaleFunc) (float  scale,
+                                    void  *arg1,
+                                    void  *arg2);
+@@ -2527,9 +2554,12 @@ for_each_scale (unsigned int      width,
+         {
+           float scale;
+ 
+-          /* Accept only scales that divide perfectly into the screen */
+-          if (((width * denominator) % numerator) != 0 ||
+-              ((height * denominator) % numerator) != 0)
++          /* Accept only scales that divide perfectly into the screen,
++           * except on a handheld panel, whose logical size may be rounded
++           * to whole pixels (see meta_monitor_scale_is_exact()). */
++          if ((((width * denominator) % numerator) != 0 ||
++               ((height * denominator) % numerator) != 0) &&
++              !meta_monitor_allows_inexact_scales ())
+             continue;
+ 
+           /* Eliminate equivalent fractions (duplicate scales) */
diff --git a/patches/mutter/0031-kms-utils-Trust-the-modes-vertical-refresh-over-its-clock.patch b/patches/mutter/0031-kms-utils-Trust-the-modes-vertical-refresh-over-its-clock.patch
new file mode 100644
index 00000000..08f9fab9
--- /dev/null
+++ b/patches/mutter/0031-kms-utils-Trust-the-modes-vertical-refresh-over-its-clock.patch
@@ -0,0 +1,46 @@
+From: none24smu <210309088+none24smu@users.noreply.github.com>
+Subject: [PATCH] kms-utils: Trust a mode's vertical refresh over its clock
+
+Mutter derives a mode's refresh rate from its pixel clock and totals. A
+command-mode panel paces itself by its tearing-effect signal, and Qualcomm's
+downstream SDE driver gives such modes a link clock unrelated to that: the
+Surface Duo 2's 60 and 90 Hz modes both work out at 43.57 Hz, so the frame
+clock ran at 43.57 Hz and animations stuttered. When the computed rate is
+more than a hertz away from the mode's own vrefresh, use vrefresh; a driver
+that fills both in consistently (vrefresh is the rounded rate) is unaffected.
+
+---
+diff --git a/src/backends/native/meta-kms-utils.c b/src/backends/native/meta-kms-utils.c
+--- a/src/backends/native/meta-kms-utils.c
++++ b/src/backends/native/meta-kms-utils.c
+@@ -27,6 +27,8 @@
+ {
+   double numerator;
+   double denominator;
++  double refresh_rate;
++  double difference;
+ 
+   if (drm_mode->htotal <= 0 || drm_mode->vtotal <= 0)
+     return 0.0;
+@@ -35,8 +37,20 @@
+   denominator = (double) drm_mode->vtotal * drm_mode->htotal;
+   if (drm_mode->vscan > 1)
+     denominator *= drm_mode->vscan;
++  refresh_rate = numerator / denominator;
+ 
+-  return (float) (numerator / denominator);
++  /*
++   * A command-mode panel paces itself by its tearing-effect signal, and some
++   * drivers (Qualcomm's downstream SDE) give its modes a link clock that
++   * says nothing about that: the Surface Duo 2's 60 and 90 Hz modes both
++   * work out at 43.57 Hz. The mode's own vertical refresh is then the true
++   * rate; a driver that fills it in consistently is never off by a hertz.
++   */
++  difference = refresh_rate - drm_mode->vrefresh;
++  if (drm_mode->vrefresh > 0 && (difference > 1.0 || difference < -1.0))
++    return (float) drm_mode->vrefresh;
++
++  return (float) refresh_rate;
+ }
+ 
+ int64_t
